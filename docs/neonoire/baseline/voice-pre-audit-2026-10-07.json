{"note":"The recorded dialogue (audio, absent where the frame was silent) and duration of the bundle frames the 7 October 2026 voice pass changed; replayed by scripts/verify-revision-restoration.mjs.","frames":{"neonoire-shot-333":{"duration":9},"neonoire-shot-10":{"audio":[{"id":"s1-oldman-twenty-years","character":"OLD MAN","text":"Twenty years.","src":"/audio/neonoire/s1/09-oldman-twenty-years.mp3","offset":0.6,"duration":1.57,"voice":"y7NkiaxPRjIzeTdRhHDC","model":"eleven_v4"}],"duration":9},"neonoire-shot-166":{"audio":[{"id":"s10-vera-are-you-the-one-they-call","character":"VERA","text":"Are you the one they call Jack?","src":"/audio/neonoire/s10/166-vera-are-you-the-one-they-call.mp3","offset":0.5,"duration":2.12,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s10-jack-dryly-depends-who-s-calling","character":"JACK","text":"Depends who's calling.","src":"/audio/neonoire/s10/166-jack-dryly-depends-who-s-calling.mp3","offset":3.1,"duration":1.96,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s10-vera-mr-okada-the-bar-in-kanda","character":"VERA","text":"Mr. Okada. The bar in Kanda.","src":"/audio/neonoire/s10/166-vera-mr-okada-the-bar-in-kanda.mp3","offset":5.6,"duration":3,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s10-jack-calmly-sit-down","character":"JACK","text":"Sit down.","src":"/audio/neonoire/s10/166-jack-calmly-sit-down.mp3","offset":9.1,"duration":1.41,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s10-vera-evenly-my-sister-has-been-missing","character":"VERA","text":"My sister has been missing for four days. The police say to go home and wait.","src":"/audio/neonoire/s10/166-vera-evenly-my-sister-has-been-missing.mp3","offset":11.2,"duration":5.25,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s10-jack-flatly-i-don-t-do-missing","character":"JACK","text":"I don't do missing persons. People who go missing usually want to.","src":"/audio/neonoire/s10/166-jack-flatly-i-don-t-do-missing.mp3","offset":17,"duration":5.41,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s10-vera-steadily-she-was-in-that-bar","character":"VERA","text":"She was in that bar. The night two men were shot there.","src":"/audio/neonoire/s10/166-vera-steadily-she-was-in-that-bar.mp3","offset":23,"duration":4.13,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s10-jack-what-did-the-police-tell-you","character":"JACK","text":"What did the police tell you?","src":"/audio/neonoire/s10/166-jack-what-did-the-police-tell-you.mp3","offset":27.6,"duration":1.65,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":30},"neonoire-shot-251":{"audio":[{"id":"s11-ishida-tired-it-s-late-jack","character":"ISHIDA","text":"It's late, Jack.","src":"/audio/neonoire/s11/251-ishida-tired-it-s-late-jack.mp3","offset":0.5,"duration":2.12,"voice":"6wGe4cP3pH5TRuKntC6Z","model":"eleven_v4"},{"id":"s11-jack-the-voss-girl-came-to-see","character":"JACK","text":"The Voss girl came to see me.","src":"/audio/neonoire/s11/251-jack-the-voss-girl-came-to-see.mp3","offset":3.2,"duration":2.04,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s11-ishida-i-know","character":"ISHIDA","text":"I know.","src":"/audio/neonoire/s11/251-ishida-i-know.mp3","offset":5.8,"duration":1.07,"voice":"6wGe4cP3pH5TRuKntC6Z","model":"eleven_v4"},{"id":"s11-jack-low-her-sister-was-in-that","character":"JACK","text":"Her sister was in that bar.","src":"/audio/neonoire/s11/251-jack-low-her-sister-was-in-that.mp3","offset":8.4,"duration":2.12,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s11-ishida-the-sister-is-a-missing-persons","character":"ISHIDA","text":"The sister is a missing persons case. The bar is a gang matter. Two separate things.","src":"/audio/neonoire/s11/251-ishida-the-sister-is-a-missing-persons.mp3","offset":11,"duration":6.19,"voice":"6wGe4cP3pH5TRuKntC6Z","model":"eleven_v4"},{"id":"s11-jack-and-the-old-man-in-the","character":"JACK","text":"And the old man in the street?","src":"/audio/neonoire/s11/251-jack-and-the-old-man-in-the.mp3","offset":17.7,"duration":1.72,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s11-ishida-sakai-pause-yes-that-sakai-i","character":"ISHIDA","text":"Sakai. Yes. That Sakai. I know what you're thinking. Old debts, old enemies. It's a gang matter.","src":"/audio/neonoire/s11/251-ishida-sakai-pause-yes-that-sakai-i.mp3","offset":19.9,"duration":8.44,"voice":"6wGe4cP3pH5TRuKntC6Z","model":"eleven_v4"},{"id":"s11-jack-pause-twenty-years-ishida","character":"JACK","text":"Twenty years, Ishida.","src":"/audio/neonoire/s11/251-jack-pause-twenty-years-ishida.mp3","offset":29.6,"duration":2.27,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s11-ishida-gently-go-to-sleep-jack-you","character":"ISHIDA","text":"Go to sleep, Jack. You're too old to be haunted.","src":"/audio/neonoire/s11/251-ishida-gently-go-to-sleep-jack-you.mp3","offset":33.3,"duration":3.79,"voice":"6wGe4cP3pH5TRuKntC6Z","model":"eleven_v4"}],"duration":38},"neonoire-shot-170":{"duration":12},"neonoire-shot-247":{"audio":[{"id":"s12-barber-grumbling-police-again","character":"BARBER","text":"Police again?","src":"/audio/neonoire/s12/247-barber-grumbling-police-again.mp3","offset":0.5,"duration":2.43,"voice":"5GswypvgtPl0hKqvIA4k","model":"eleven_v4"},{"id":"s12-jack-not-for-a-long-time","character":"JACK","text":"Not for a long time.","src":"/audio/neonoire/s12/247-jack-not-for-a-long-time.mp3","offset":3.5,"duration":2.04,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s12-barber-i-told-them-i-was-asleep","character":"BARBER","text":"I told them. I was asleep. I heard the shot. Then a car.","src":"/audio/neonoire/s12/247-barber-i-told-them-i-was-asleep.mp3","offset":6.1,"duration":5.41,"voice":"5GswypvgtPl0hKqvIA4k","model":"eleven_v4"},{"id":"s12-jack-one-car","character":"JACK","text":"One car?","src":"/audio/neonoire/s12/247-jack-one-car.mp3","offset":12,"duration":0.99,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s12-barber-one-car-twice-pause-it-left","character":"BARBER","text":"One car. Twice. It left. Then it came back.","src":"/audio/neonoire/s12/247-barber-one-car-twice-pause-it-left.mp3","offset":13.5,"duration":6.27,"voice":"5GswypvgtPl0hKqvIA4k","model":"eleven_v4"},{"id":"s12-jack-quietly-why-come-back","character":"JACK","text":"Why come back?","src":"/audio/neonoire/s12/247-jack-quietly-why-come-back.mp3","offset":20.6,"duration":1.57,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s12-jack-quietly-because-they-didn-t-find","character":"JACK","text":"Because they didn't find it.","src":"/audio/neonoire/s12/247-jack-quietly-because-they-didn-t-find.mp3","offset":24,"duration":1.72,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":27},"neonoire-shot-184":{"audio":[{"id":"s14-jack-when-were-you-last-here","character":"JACK","text":"When were you last here?","src":"/audio/neonoire/s14/184-jack-when-were-you-last-here.mp3","offset":0.5,"duration":1.57,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s14-vera-wryly-a-week-ago-she-made","character":"VERA","text":"A week ago. She made me coffee. It was terrible.","src":"/audio/neonoire/s14/184-vera-wryly-a-week-ago-she-made.mp3","offset":2.6,"duration":4.6,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s14-jack-quietly-she-wasn-t-planning-to","character":"JACK","text":"She wasn't planning to leave.","src":"/audio/neonoire/s14/184-jack-quietly-she-wasn-t-planning-to.mp3","offset":7.9,"duration":2.12,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s14-vera-no","character":"VERA","text":"No.","src":"/audio/neonoire/s14/184-vera-no.mp3","offset":10.6,"duration":0.76,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"}],"duration":14},"neonoire-shot-185":{"audio":[{"id":"s14-jack-she-drew-this-a-lot","character":"JACK","text":"She drew this a lot.","src":"/audio/neonoire/s14/185-jack-she-drew-this-a-lot.mp3","offset":0.5,"duration":1.65,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s14-vera-since-she-was-little-it-s","character":"VERA","text":"Since she was little. It's from a story I used to tell her. About the noodle shop Dad took us to. She was too young to remember it, so I told her. She made it up from what I said. It's not real.","src":"/audio/neonoire/s14/185-vera-since-she-was-little-it-s.mp3","offset":2.7,"duration":13.01,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s14-jack-can-i-borrow-this","character":"JACK","text":"Can I borrow this?","src":"/audio/neonoire/s14/185-jack-can-i-borrow-this.mp3","offset":16.7,"duration":1.31,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s14-vera-why","character":"VERA","text":"Why?","src":"/audio/neonoire/s14/185-vera-why.mp3","offset":18.6,"duration":0.91,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s14-jack-softly-people-draw-the-places-they","character":"JACK","text":"People draw the places they want to go.","src":"/audio/neonoire/s14/185-jack-softly-people-draw-the-places-they.mp3","offset":20.1,"duration":2.77,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":24},"neonoire-shot-363":{"duration":6},"neonoire-shot-336":{"duration":8},"neonoire-shot-337":{"duration":9},"neonoire-shot-339":{"duration":10},"neonoire-shot-342":{"duration":6},"neonoire-shot-343":{"duration":9},"neonoire-shot-194":{"audio":[{"id":"s20-jack-she-says-it-was-hers-she","character":"JACK","text":"She says it was hers. She says you stole it when you were kids and never gave it back.","src":"/audio/neonoire/s20/194-jack-she-says-it-was-hers-she.mp3","offset":0.5,"duration":5.25,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s20-mara-tearfully-it-was-never-hers-dad","character":"MARA","text":"It was never hers. Dad gave it to me. She just says that.","src":"/audio/neonoire/s20/194-mara-tearfully-it-was-never-hers-dad.mp3","offset":6.3,"duration":5.07,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s20-jack-is-she-okay-is-she-does","character":"JACK","text":"Is she okay? Is she — does she know you're —","src":"/audio/neonoire/s20/194-jack-is-she-okay-is-she-does.mp3","offset":11.9,"duration":3.79,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s20-mara-bitterly-is-she-okay","character":"MARA","text":"Is she okay?","src":"/audio/neonoire/s20/194-mara-bitterly-is-she-okay.mp3","offset":15.3,"duration":1.49,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s20-jack-she-s-been-calling-you-she","character":"JACK","text":"She's been calling you. She hasn't slept.","src":"/audio/neonoire/s20/194-jack-she-s-been-calling-you-she.mp3","offset":17.4,"duration":3,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s20-mara-flatly-i-know-i-listen-to","character":"MARA","text":"I know. I listen to them.","src":"/audio/neonoire/s20/194-mara-flatly-i-know-i-listen-to.mp3","offset":21,"duration":2.35,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s20-jack-why-were-you-in-kanda-mara","character":"JACK","text":"Why were you in Kanda, Mara?","src":"/audio/neonoire/s20/194-jack-why-were-you-in-kanda-mara.mp3","offset":24,"duration":2.04,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s20-mara-he-wrote-to-vera-mr-sakai","character":"MARA","text":"He wrote to Vera. Mr. Sakai. She threw it in the bin without even answering. I took it out. I called him. He said he had Dad's papers. He said to come to the bar at one o'clock. There'd be a man from a newspaper there too, so it couldn't be buried again.","src":"/audio/neonoire/s20/194-mara-he-wrote-to-vera-mr-sakai.mp3","offset":26.8,"duration":18.13,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s20-mara-i-sent-them-both-a-photo","character":"MARA","text":"I sent them both a photo so they'd know me. He wrote back one line. \"You have his face.\"","src":"/audio/neonoire/s20/194-mara-i-sent-them-both-a-photo.mp3","offset":45.6,"duration":6.92,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s20-jack-vera-doesn-t-know-you-went","character":"JACK","text":"Vera doesn't know you went.","src":"/audio/neonoire/s20/194-jack-vera-doesn-t-know-you-went.mp3","offset":53.3,"duration":1.8,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":56},"neonoire-shot-284":{"audio":[{"id":"s20-mara-we-had-a-fight-about-it","character":"MARA","text":"We had a fight about it. I called her a coward. And I'm the one hiding in a storeroom. Don't tell her I'm here.","src":"/audio/neonoire/s20/284-mara-we-had-a-fight-about-it.mp3","offset":0.5,"duration":8.44,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s20-jack-she-s-your-sister","character":"JACK","text":"She's your sister.","src":"/audio/neonoire/s20/284-jack-she-s-your-sister.mp3","offset":9.5,"duration":1.41,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s20-mara-urgently-they-have-my-purse-they","character":"MARA","text":"They have my purse. They know my name. They know where I live, where she lives, all of it. If she knows where I am, she'll come here. She won't be able to help it. And they'll follow her. They'll use her to get to me. And then they'll kill her too.","src":"/audio/neonoire/s20/284-mara-urgently-they-have-my-purse-they.mp3","offset":11.5,"duration":15.31,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s20-jack-you-don-t-know-that","character":"JACK","text":"You don't know that.","src":"/audio/neonoire/s20/284-jack-you-don-t-know-that.mp3","offset":27.4,"duration":1.31,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s20-mara-tearfully-i-watched-them-shoot-two","character":"MARA","text":"I watched them shoot two men like they were switching off lights.","src":"/audio/neonoire/s20/284-mara-tearfully-i-watched-them-shoot-two.mp3","offset":29.3,"duration":4.05,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s20-mara-promise-me","character":"MARA","text":"Promise me.","src":"/audio/neonoire/s20/284-mara-promise-me.mp3","offset":35.5,"duration":1.23,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s20-jack-i-promise","character":"JACK","text":"I promise.","src":"/audio/neonoire/s20/284-jack-i-promise.mp3","offset":38.3,"duration":1.23,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":41},"neonoire-shot-197":{"audio":[{"id":"s22-vera-he-used-to-bring-us-somewhere","character":"VERA","text":"He used to bring us somewhere like this. Dad. After work. Mara would fall asleep on the counter and he'd carry her home.","src":"/audio/neonoire/s22/197-vera-he-used-to-bring-us-somewhere.mp3","offset":0.5,"duration":8.28,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s22-jack-and-you","character":"JACK","text":"And you?","src":"/audio/neonoire/s22/197-jack-and-you.mp3","offset":9.3,"duration":0.84,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s22-vera-i-stayed-awake-i-wanted-to","character":"VERA","text":"I stayed awake. I wanted to hear everything he said to the man who made the noodles. I didn't understand any of it. I just liked that he was different here. Lighter. I think he was happy here. Before.","src":"/audio/neonoire/s22/197-vera-i-stayed-awake-i-wanted-to.mp3","offset":10.7,"duration":14.6,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s22-vera-they-said-he-killed-himself-my","character":"VERA","text":"They said he killed himself. My mother never talked about it. Not once. We went home and it was as if Tokyo never happened.","src":"/audio/neonoire/s22/197-vera-they-said-he-killed-himself-my.mp3","offset":26.2,"duration":9.09,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s22-jack-do-you-believe-it","character":"JACK","text":"Do you believe it?","src":"/audio/neonoire/s22/197-jack-do-you-believe-it.mp3","offset":35.9,"duration":1.23,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s22-vera-i-believe-he-was-sad-i","character":"VERA","text":"I believe he was sad. I don't know if I believe the rest. A man wrote to me. Last month. An old man. He said Dad didn't kill himself. He said he could prove it.","src":"/audio/neonoire/s22/197-vera-i-believe-he-was-sad-i.mp3","offset":37.9,"duration":13.24,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s22-jack-carefully-what-did-you-do","character":"JACK","text":"What did you do?","src":"/audio/neonoire/s22/197-jack-carefully-what-did-you-do.mp3","offset":51.7,"duration":1.88,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s22-vera-i-threw-it-in-the-bin","character":"VERA","text":"I threw it in the bin. Because if it's true, then someone did it. And nobody looked. Twenty years, and nobody even looked.","src":"/audio/neonoire/s22/197-vera-i-threw-it-in-the-bin.mp3","offset":54.3,"duration":9.8,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"}],"duration":65},"neonoire-shot-202":{"audio":[{"id":"s13-kaneko-gruffly-eat","character":"KANEKO","text":"Eat.","src":"/audio/neonoire/s13/181-kaneko-gruffly-eat.mp3","offset":0.5,"duration":1.07,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s13-mara-hesitantly-thank-you-has-anyone-come","character":"MARA","text":"Thank you. Has anyone... come? Asking?","src":"/audio/neonoire/s13/181-mara-hesitantly-thank-you-has-anyone-come.mp3","offset":2.22,"duration":4.68,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s13-kaneko-flatly-nobody-comes-here-who-isn","character":"KANEKO","text":"Nobody comes here who isn't lost.","src":"/audio/neonoire/s13/181-kaneko-flatly-nobody-comes-here-who-isn.mp3","offset":7.55,"duration":2.51,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s25-mara-mr-sakai-said-twenty-years-before","character":"MARA","text":"Mr. Sakai said \"twenty years.\" Before they shot him. Like he'd been expecting them for twenty years.","src":"/audio/neonoire/s25/202-mara-mr-sakai-said-twenty-years-before.mp3","offset":10.71,"duration":7.39,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s25-jack-he-probably-had","character":"JACK","text":"He probably had.","src":"/audio/neonoire/s25/202-jack-he-probably-had.mp3","offset":18.75,"duration":1.72,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s25-jack-you-drew-this","character":"JACK","text":"You drew this.","src":"/audio/neonoire/s25/202-jack-you-drew-this.mp3","offset":21.12,"duration":1.31,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s25-mara-and-then-in-the-bar-the","character":"MARA","text":"And then in the bar, the man said, \"Where is he?\" He was waiting for the old man. They were supposed to meet.","src":"/audio/neonoire/s25/202-mara-and-then-in-the-bar-the.mp3","offset":23.08,"duration":7.39,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s25-jack-sakai-was-bringing-him-something","character":"JACK","text":"Sakai was bringing him something.","src":"/audio/neonoire/s25/202-jack-sakai-was-bringing-him-something.mp3","offset":31.12,"duration":2.12,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s25-mara-this","character":"MARA","text":"This.","src":"/audio/neonoire/s25/202-mara-this.mp3","offset":33.89,"duration":0.84,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s25-mara-it-s-the-only-thing-i","character":"MARA","text":"It's the only thing I know how to do with it. If I don't put it on paper it just keeps happening. That's what he said when he came into the bar. \"Excuse me.\" Like a customer. He said it in the lane too, before —","src":"/audio/neonoire/s25/202-mara-it-s-the-only-thing-i.mp3","offset":35.38,"duration":14.84,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"}],"duration":51},"neonoire-shot-291":{"audio":[{"id":"s27a-okada-he-finds-things-and-then-he","character":"OKADA","text":"He finds things. And then he carries them by himself. I have never seen him put anything down.","src":"/audio/neonoire/s27a/291-okada-he-finds-things-and-then-he.mp3","offset":0.3,"duration":7.63,"voice":"MhuU9Z2dyWAG6ZjuuKRg","model":"eleven_v4"},{"id":"s27a-vera-is-that-a-warning","character":"VERA","text":"Is that a warning?","src":"/audio/neonoire/s27a/291-vera-is-that-a-warning.mp3","offset":8.7,"duration":1.57,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s27a-okada-it-s-a-description","character":"OKADA","text":"It's a description.","src":"/audio/neonoire/s27a/291-okada-it-s-a-description.mp3","offset":11.02,"duration":1.49,"voice":"MhuU9Z2dyWAG6ZjuuKRg","model":"eleven_v4"},{"id":"s27a-vera-where-did-you-find-the-clip","character":"VERA","text":"Where did you find the clip?","src":"/audio/neonoire/s27a/291-vera-where-did-you-find-the-clip.mp3","offset":13.46,"duration":1.72,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"}],"duration":16},"neonoire-shot-273":{"audio":[{"id":"s29-mrssakai-he-started-going-to-temple-last","character":"MRS. SAKAI","text":"He started going to temple last year. Him. Temple. He sat there for hours. I thought he'd gone soft in the head. Last month he wrote a letter. In English. Him. He made me check the spelling. To an American girl. When the doctor told him, he said he was glad. He said now he could stop being afraid of the wrong thing.","src":"/audio/neonoire/s29/273-mrssakai-he-started-going-to-temple-last.mp3","offset":0.4,"duration":25.16,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s29-jack-did-he-ever-pay-rent-on","character":"JACK","text":"Did he ever pay rent on something? Somewhere that wasn't his home?","src":"/audio/neonoire/s29/273-jack-did-he-ever-pay-rent-on.mp3","offset":26.52,"duration":4.36,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s29-mrssakai-every-january-cash-in-an-envelope","character":"MRS. SAKAI","text":"Every January. Cash, in an envelope. Twenty years. Even the years we had nothing, he paid it. I thought it was a woman.","src":"/audio/neonoire/s29/273-mrssakai-every-january-cash-in-an-envelope.mp3","offset":31.84,"duration":10.11,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s29-mrssakai-he-left-these-here-maybe-on","character":"MRS. SAKAI","text":"He left these here. Maybe on purpose.","src":"/audio/neonoire/s29/273-mrssakai-he-left-these-here-maybe-on.mp3","offset":43.52,"duration":3.24,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s29-mrssakai-whatever-it-is-it-was-heavier","character":"MRS. SAKAI","text":"Whatever it is, it was heavier than me. He carried it longer.","src":"/audio/neonoire/s29/273-mrssakai-whatever-it-is-it-was-heavier.mp3","offset":48.72,"duration":4.75,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"}],"duration":55},"neonoire-shot-210":{"audio":[{"id":"s36-vera-mara","character":"VERA","text":"Mara?","src":"/audio/neonoire/s36/210-vera-mara.mp3","offset":0.3,"duration":0.99,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s36-jack-it-s-me","character":"JACK","text":"It's me.","src":"/audio/neonoire/s36/210-jack-it-s-me.mp3","offset":2.26,"duration":0.84,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s36-vera-where-are-you-you-sound-like","character":"VERA","text":"Where are you? You sound like you're calling from 1985.","src":"/audio/neonoire/s36/210-vera-where-are-you-you-sound-like.mp3","offset":4.26,"duration":3.97,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s36-jack-the-countryside-there-s-no-signal","character":"JACK","text":"The countryside. There's no signal. I'm on a payphone. It's pink.","src":"/audio/neonoire/s36/210-jack-the-countryside-there-s-no-signal.mp3","offset":9.08,"duration":5.15,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s36-vera-did-you-find-anything","character":"VERA","text":"Did you find anything?","src":"/audio/neonoire/s36/210-vera-did-you-find-anything.mp3","offset":15.2,"duration":1.31,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s36-jack-maybe-i-ll-know-tomorrow","character":"JACK","text":"Maybe. I'll know tomorrow.","src":"/audio/neonoire/s36/210-jack-maybe-i-ll-know-tomorrow.mp3","offset":18.08,"duration":2.27,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s36-vera-come-back-safe","character":"VERA","text":"Come back safe.","src":"/audio/neonoire/s36/210-vera-come-back-safe.mp3","offset":21.32,"duration":1.41,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s36-jack-it-s-just-an-inn-there","character":"JACK","text":"It's just an inn. There's an old couple and a baseball game.","src":"/audio/neonoire/s36/210-jack-it-s-just-an-inn-there.mp3","offset":23.48,"duration":3.97,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s36-vera-come-back-safe-anyway","character":"VERA","text":"Come back safe anyway.","src":"/audio/neonoire/s36/210-vera-come-back-safe-anyway.mp3","offset":28.3,"duration":1.8,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"}],"duration":31},"neonoire-shot-233":{"audio":[{"id":"s64-jack-keep-this-for-me-don-t","character":"JACK","text":"Keep this for me. Don't tell anyone. Not the police. Not me, if I ask you with someone standing behind me.","src":"/audio/neonoire/s64/233-jack-keep-this-for-me-don-t.mp3","offset":0.3,"duration":7.31,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s64-okada-behind-the-counter-like-the-girl","character":"OKADA","text":"Behind the counter. Like the girl's clip.","src":"/audio/neonoire/s64/233-okada-behind-the-counter-like-the-girl.mp3","offset":9.18,"duration":3.16,"voice":"MhuU9Z2dyWAG6ZjuuKRg","model":"eleven_v4"},{"id":"s64-jack-tomorrow-it-ll-be-over","character":"JACK","text":"Tomorrow it'll be over.","src":"/audio/neonoire/s64/233-jack-tomorrow-it-ll-be-over.mp3","offset":14.3,"duration":1.96,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s64-okada-that-s-what-people-say-the","character":"OKADA","text":"That's what people say the night before.","src":"/audio/neonoire/s64/233-okada-that-s-what-people-say-the.mp3","offset":17.22,"duration":2.51,"voice":"MhuU9Z2dyWAG6ZjuuKRg","model":"eleven_v4"}],"duration":21},"neonoire-shot-239":{"audio":[{"id":"s70-driver-excuse-me","character":"DRIVER","text":"Excuse me.","src":"/audio/neonoire/s70/239-driver-excuse-me.mp3","offset":0.4,"duration":0.99,"voice":"IUNPSr7i3o1XsExH6IGv","model":"eleven_v4"},{"id":"s70-mara-that-s-them","character":"MARA","text":"That's them.","src":"/audio/neonoire/s70/239-mara-that-s-them.mp3","offset":2.36,"duration":1.15,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s70-jack-what","character":"JACK","text":"What?","src":"/audio/neonoire/s70/239-jack-what.mp3","offset":3.98,"duration":0.76,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s70-mara-that-s-what-he-said-before","character":"MARA","text":"That's what he said. Before he shot him. \"Excuse me.\"","src":"/audio/neonoire/s70/239-mara-that-s-what-he-said-before.mp3","offset":5.2,"duration":4.28,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s70-driver-position","character":"DRIVER","text":"Position.","src":"/audio/neonoire/s70/239-driver-position.mp3","offset":10.64,"duration":0.99,"voice":"IUNPSr7i3o1XsExH6IGv","model":"eleven_v4"},{"id":"s70-jack-urgently-run","character":"JACK","text":"Run!","src":"/audio/neonoire/s70/239-jack-urgently-run.mp3","offset":12.4,"duration":0.99,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":14},"neonoire-shot-315":{"duration":8},"neonoire-shot-87":{"duration":14},"neonoire-shot-286":{"duration":8},"neonoire-shot-94":{"duration":8},"neonoire-shot-97":{"duration":34},"neonoire-shot-98":{"duration":5},"neonoire-shot-99":{"duration":18},"neonoire-shot-104":{"duration":5},"neonoire-shot-108":{"duration":30},"neonoire-shot-109":{"duration":12},"neonoire-shot-301":{"duration":14},"neonoire-shot-302":{"duration":20},"neonoire-shot-111":{"duration":12},"neonoire-shot-112":{"duration":30},"neonoire-shot-317":{"duration":6},"neonoire-shot-113":{"audio":[{"id":"s24-kurose-and","character":"KUROSE","text":"And?","src":"/audio/neonoire/s24/201-kurose-and.mp3","offset":6.7,"duration":0.84,"voice":"N7WASm2wYJmE5JmsJPLJ","model":"eleven_v4"}],"duration":10},"neonoire-shot-114":{"duration":10},"neonoire-shot-115":{"duration":8},"neonoire-shot-116":{"duration":6},"neonoire-shot-318":{"duration":5},"neonoire-shot-118":{"duration":20},"neonoire-shot-119":{"duration":30},"neonoire-shot-124":{"duration":8},"neonoire-shot-125":{"duration":6},"neonoire-shot-137":{"duration":12},"neonoire-shot-138":{"duration":10},"neonoire-shot-143":{"duration":8},"neonoire-shot-303":{"duration":12},"neonoire-shot-155":{"duration":10},"neonoire-shot-156":{"audio":[{"id":"s98-jack-sorry","character":"JACK","text":"At the end, she asked me to tell you something. She said to tell you she was sorry.","src":"/audio/neonoire/s98/156-jack-tell-her-sorry.mp3","offset":0.4,"duration":5.99,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_multilingual_v2"}],"duration":7},"neonoire-shot-157":{"audio":[{"id":"s98-vera-rain","character":"VERA","text":"You could have told me that in the rain.","src":"/audio/neonoire/s98/157-vera-in-the-rain.mp3","offset":9,"duration":1.95,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_multilingual_v2"}],"duration":14},"neonoire-shot-15":{"audio":[{"id":"s1-oldman-strained-don-t-let-them-have","character":"OLD MAN","text":"Don't let them have it.","src":"/audio/neonoire/s1/15-oldman-strained-don-t-let-them-have.mp3","offset":2,"duration":2.19,"voice":"y7NkiaxPRjIzeTdRhHDC","model":"eleven_v4"},{"id":"s1-mara-bewildered-have-what-i-don-t","character":"MARA","text":"Have what? I don't —","src":"/audio/neonoire/s1/15-mara-bewildered-have-what-i-don-t.mp3","offset":5.5,"duration":2.43,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"}],"duration":9},"neonoire-shot-297":{"audio":[{"id":"s53a-harada-you-re-not-a-reporter","character":"HARADA","text":"You're not a reporter.","src":"/audio/neonoire/s53a/297-harada-you-re-not-a-reporter.mp3","offset":0.6,"duration":1.57,"voice":"hpp4J3VqNfWAUOO0d1Us","model":"eleven_v4"},{"id":"s53a-vera-my-sister-was-in-that-bar","character":"VERA","text":"My sister was in that bar.","src":"/audio/neonoire/s53a/297-vera-my-sister-was-in-that-bar.mp3","offset":2.82,"duration":2.04,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s53a-harada-we-have-had-a-letter-from","character":"HARADA","text":"We have had a letter from lawyers already. Kondo was six months on the redevelopment money. Who owns what. Whose friends sit on which committee. He never touched a gang in his life.","src":"/audio/neonoire/s53a/297-harada-we-have-had-a-letter-from.mp3","offset":5.51,"duration":11.73,"voice":"hpp4J3VqNfWAUOO0d1Us","model":"eleven_v4"},{"id":"s53a-vera-the-police-say-it-s-a","character":"VERA","text":"The police say it's a gang matter.","src":"/audio/neonoire/s53a/297-vera-the-police-say-it-s-a.mp3","offset":17.89,"duration":2.51,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s53a-harada-the-police-say-what-they-are","character":"HARADA","text":"The police say what they are told.","src":"/audio/neonoire/s53a/297-harada-the-police-say-what-they-are.mp3","offset":21.05,"duration":2.35,"voice":"hpp4J3VqNfWAUOO0d1Us","model":"eleven_v4"},{"id":"s53a-vera-did-he-say-who-he-was","character":"VERA","text":"Did he say who he was meeting?","src":"/audio/neonoire/s53a/297-vera-did-he-say-who-he-was.mp3","offset":24.05,"duration":1.96,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s53a-harada-one-o-clock-kanda-an-old","character":"HARADA","text":"One o'clock, Kanda, an old man who wanted to talk. He told two people. Me. And a detective.","src":"/audio/neonoire/s53a/297-harada-one-o-clock-kanda-an-old.mp3","offset":26.66,"duration":8.05,"voice":"hpp4J3VqNfWAUOO0d1Us","model":"eleven_v4"},{"id":"s53a-vera-which-detective","character":"VERA","text":"Which detective?","src":"/audio/neonoire/s53a/297-vera-which-detective.mp3","offset":35.36,"duration":1.31,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s53a-harada-he-didn-t-say-he-said","character":"HARADA","text":"He didn't say. He said the detective had promised to keep a car nearby. There was no car.","src":"/audio/neonoire/s53a/297-harada-he-didn-t-say-he-said.mp3","offset":37.32,"duration":6.03,"voice":"hpp4J3VqNfWAUOO0d1Us","model":"eleven_v4"}],"duration":44},"neonoire-shot-298":{"audio":[{"id":"s53a-vera-will-you-print-it","character":"VERA","text":"Will you print it?","src":"/audio/neonoire/s53a/298-vera-will-you-print-it.mp3","offset":1.3,"duration":1.07,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s53a-harada-print-what-a-dead-man-s","character":"HARADA","text":"Print what? A dead man's diary? Bring me something with a name on it.","src":"/audio/neonoire/s53a/298-harada-print-what-a-dead-man-s.mp3","offset":3.02,"duration":4.75,"voice":"hpp4J3VqNfWAUOO0d1Us","model":"eleven_v4"}],"duration":30},"neonoire-shot-206":{"audio":[{"id":"s29-mrssakai-we-haven-t-lived-together-in","character":"MRS. SAKAI","text":"We haven't lived together in fifteen years. The police already came.","src":"/audio/neonoire/s29/206-mrssakai-we-haven-t-lived-together-in.mp3","offset":0.3,"duration":4.83,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s29-jack-i-m-not-the-police","character":"JACK","text":"I'm not the police.","src":"/audio/neonoire/s29/206-jack-i-m-not-the-police.mp3","offset":6.1,"duration":1.49,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s29-mrssakai-then-what-are-you","character":"MRS. SAKAI","text":"Then what are you?","src":"/audio/neonoire/s29/206-mrssakai-then-what-are-you.mp3","offset":8.34,"duration":1.57,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s29-jack-someone-who-owes-a-man-a","character":"JACK","text":"Someone who owes a man a debt. A long time ago. The same kind of debt your husband owed.","src":"/audio/neonoire/s29/206-jack-someone-who-owes-a-man-a.mp3","offset":11.46,"duration":6.53,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":20},"neonoire-shot-172":{"audio":[{"id":"s32-mrsnoda-just-one-night","character":"MRS. NODA","text":"Just one night?","src":"/audio/neonoire/s32/172-mrsnoda-just-one-night.mp3","offset":0.3,"duration":1.31,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s32-jack-just-one","character":"JACK","text":"Just one.","src":"/audio/neonoire/s32/172-jack-just-one.mp3","offset":2.28,"duration":0.99,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":10},"neonoire-shot-173":{"audio":[{"id":"s32-mrsnoda-upstairs-at-the-end-the-bath","character":"MRS. NODA","text":"Upstairs, at the end. The bath is shared, I'm sorry. I'll show you. The light doesn't work properly.","src":"/audio/neonoire/s32/173-mrsnoda-upstairs-at-the-end-the-bath.mp3","offset":0.3,"duration":7.89,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"}],"duration":9},"neonoire-shot-208":{"audio":[{"id":"s33-mrsnoda-kitchen-if-you-want-tea-just","character":"MRS. NODA","text":"Kitchen. If you want tea, just take it. The back door sticks. My husband says he'll fix it. He's said so since the Olympics.","src":"/audio/neonoire/s33/208-mrsnoda-kitchen-if-you-want-tea-just.mp3","offset":0.3,"duration":8.99,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s33-jack-which-olympics","character":"JACK","text":"Which Olympics?","src":"/audio/neonoire/s33/208-jack-which-olympics.mp3","offset":9.96,"duration":1.23,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s33-mrsnoda-dryly-exactly","character":"MRS. NODA","text":"Exactly.","src":"/audio/neonoire/s33/208-mrsnoda-dryly-exactly.mp3","offset":11.96,"duration":1.57,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s33-mrsnoda-if-it-s-too-steamy-the","character":"MRS. NODA","text":"If it's too steamy, the window opens. If you hit it hard enough.","src":"/audio/neonoire/s33/208-mrsnoda-if-it-s-too-steamy-the.mp3","offset":14.88,"duration":4.6,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"}],"duration":21},"neonoire-shot-211":{"audio":[{"id":"s37-mrsnoda-don-t-tell-my-husband","character":"MRS. NODA","text":"Don't tell my husband.","src":"/audio/neonoire/s37/211-mrsnoda-don-t-tell-my-husband.mp3","offset":0.3,"duration":1.8,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s37-jack-i-quit","character":"JACK","text":"I quit.","src":"/audio/neonoire/s37/211-jack-i-quit.mp3","offset":2.76,"duration":1.15,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s37-mrsnoda-then-you-ll-understand-why-i","character":"MRS. NODA","text":"Then you'll understand why I don't want him to know.","src":"/audio/neonoire/s37/211-mrsnoda-then-you-ll-understand-why-i.mp3","offset":4.58,"duration":3.4,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s37-mrsnoda-sorry-about-the-truck-he-parks","character":"MRS. NODA","text":"Sorry about the truck. He parks it like he's drunk. He's never drunk. The keys are always in it. Who would steal that?","src":"/audio/neonoire/s37/211-mrsnoda-sorry-about-the-truck-he-parks.mp3","offset":10.44,"duration":8.75,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"}],"duration":20},"neonoire-shot-214":{"audio":[{"id":"s44-jack-stay-whatever-you-hear","character":"JACK","text":"Stay. Whatever you hear.","src":"/audio/neonoire/s44/214-jack-stay-whatever-you-hear.mp3","offset":0.6,"duration":2.59,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s44-mrsnoda-my-husband","character":"MRS. NODA","text":"My husband —","src":"/audio/neonoire/s44/214-mrsnoda-my-husband.mp3","offset":3.84,"duration":1.57,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s44-jack-i-ll-get-him","character":"JACK","text":"I'll get him.","src":"/audio/neonoire/s44/214-jack-i-ll-get-him.mp3","offset":6.06,"duration":1.15,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":12},"neonoire-shot-167":{"audio":[{"id":"s10-vera-to-go-home","character":"VERA","text":"To go home.","src":"/audio/neonoire/s10/167-vera-to-go-home.mp3","offset":0.5,"duration":1.15,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s10-jack-wearily-it-s-good-advice","character":"JACK","text":"It's good advice.","src":"/audio/neonoire/s10/167-jack-wearily-it-s-good-advice.mp3","offset":2.1,"duration":2.59,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s10-vera-is-it-yours-too","character":"VERA","text":"Is it yours, too?","src":"/audio/neonoire/s10/167-vera-is-it-yours-too.mp3","offset":5.3,"duration":1.49,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s10-jack-do-you-have-photographs-of-her","character":"JACK","text":"Do you have photographs of her?","src":"/audio/neonoire/s10/167-jack-do-you-have-photographs-of-her.mp3","offset":8,"duration":1.88,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s10-vera-that-s-us-pause-before-we","character":"VERA","text":"That's us. Before we left.","src":"/audio/neonoire/s10/167-vera-that-s-us-pause-before-we.mp3","offset":11.5,"duration":2.93,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s10-jack-softly-your-father","character":"JACK","text":"Your father.","src":"/audio/neonoire/s10/167-jack-softly-your-father.mp3","offset":15,"duration":1.31,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s10-vera-quietly-he-died-pause-that-year","character":"VERA","text":"He died. That year. Here.","src":"/audio/neonoire/s10/167-vera-quietly-he-died-pause-that-year.mp3","offset":16.8,"duration":3.63,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"}],"duration":22},"neonoire-shot-168":{"audio":[{"id":"s10-jack-quietly-i-m-sorry","character":"JACK","text":"I'm sorry.","src":"/audio/neonoire/s10/168-jack-quietly-i-m-sorry.mp3","offset":0.5,"duration":1.31,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s10-vera-it-was-a-long-time-ago","character":"VERA","text":"It was a long time ago.","src":"/audio/neonoire/s10/168-vera-it-was-a-long-time-ago.mp3","offset":2.4,"duration":2.04,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s10-jack-yes","character":"JACK","text":"Yes.","src":"/audio/neonoire/s10/168-jack-yes.mp3","offset":5,"duration":0.84,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s10-jack-businesslike-ten-thousand-yen-a-day","character":"JACK","text":"Ten thousand yen a day. Plus expenses. I'll need a key to her apartment, her phone number, her friends, where she worked, where she drank.","src":"/audio/neonoire/s10/168-jack-businesslike-ten-thousand-yen-a-day.mp3","offset":7,"duration":8.59,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s10-vera-so-you-ll-look","character":"VERA","text":"So you'll look.","src":"/audio/neonoire/s10/168-vera-so-you-ll-look.mp3","offset":16.1,"duration":1.49,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s10-jack-i-ll-look","character":"JACK","text":"I'll look.","src":"/audio/neonoire/s10/168-jack-i-ll-look.mp3","offset":18,"duration":1.07,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":20},"neonoire-shot-270":{"audio":[{"id":"s14-vera-quietly-that-was-for-america-she","character":"VERA","text":"That was for America. She'd booked a flight. Next month.","src":"/audio/neonoire/s14/270-vera-quietly-that-was-for-america-she.mp3","offset":0.5,"duration":4.13,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s14-jack-you-didn-t-want-her-to","character":"JACK","text":"You didn't want her to go.","src":"/audio/neonoire/s14/270-jack-you-didn-t-want-her-to.mp3","offset":5.2,"duration":1.88,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s14-vera-i-didn-t-want-her-to","character":"VERA","text":"I didn't want her to run away again. That's what I said. The night she left. That she always runs.","src":"/audio/neonoire/s14/270-vera-i-didn-t-want-her-to.mp3","offset":7.7,"duration":7.55,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s14-vera-voice-breaking-it-was-about-dad","character":"VERA","text":"It was about Dad. It's always about Dad. She wanted to dig it all up. Who he was here. Why he — I told her to leave him dead.","src":"/audio/neonoire/s14/270-vera-voice-breaking-it-was-about-dad.mp3","offset":16.2,"duration":11.15,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s14-vera-bitterly-she-said-i-was-the","character":"VERA","text":"She said I was the one who ran. All the way back here, chasing a ghost, and I won't even look at it.","src":"/audio/neonoire/s14/270-vera-bitterly-she-said-i-was-the.mp3","offset":28.5,"duration":7,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s14-vera-quietly-i-told-her-to-go","character":"VERA","text":"I told her to go, then. Go home. Those were the last things I said to her.","src":"/audio/neonoire/s14/270-vera-quietly-i-told-her-to-go.mp3","offset":36.5,"duration":5.25,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"}],"duration":43},"neonoire-shot-189":{"audio":[{"id":"s17-kaneko-dryly-you-got-old","character":"KANEKO","text":"You got old.","src":"/audio/neonoire/s17/189-kaneko-dryly-you-got-old.mp3","offset":0.5,"duration":1.72,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s17-jack-so-did-you","character":"JACK","text":"So did you.","src":"/audio/neonoire/s17/189-jack-so-did-you.mp3","offset":2.8,"duration":1.15,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s17-kaneko-i-was-already-old-you-were","character":"KANEKO","text":"I was already old. You were a boy in a cheap suit, the only foreign face on the force. Japanese papers, American face. You came here with the American.","src":"/audio/neonoire/s17/189-kaneko-i-was-already-old-you-were.mp3","offset":4.6,"duration":11.99,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s17-jack-quietly-i-m-looking-for-his","character":"JACK","text":"I'm looking for his daughter. The younger one.","src":"/audio/neonoire/s17/189-jack-quietly-i-m-looking-for-his.mp3","offset":21.6,"duration":3,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s17-kaneko-flatly-the-little-one-she-was","character":"KANEKO","text":"The little one? She was four years old. She ate rice with her fingers.","src":"/audio/neonoire/s17/189-kaneko-flatly-the-little-one-she-was.mp3","offset":25.4,"duration":5.25,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s13-kaneko-everything-is-going-we-are-just","character":"KANEKO","text":"Everything is going. We are just slower.","src":"/audio/neonoire/s13/181-kaneko-everything-is-going-we-are-just.mp3","offset":29,"duration":3.47,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s17-jack-she-s-twenty-four-now-and","character":"JACK","text":"She's twenty-four now. And someone wants to kill her.","src":"/audio/neonoire/s17/189-jack-she-s-twenty-four-now-and.mp3","offset":31.4,"duration":3.97,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s17-kaneko-gruffly-eat-then-go-pause-there","character":"KANEKO","text":"Eat. Then go. There is no one here but us.","src":"/audio/neonoire/s17/189-kaneko-gruffly-eat-then-go-pause-there.mp3","offset":36.4,"duration":4.83,"voice":"vUzt8mUMt5vwWOoJ6szl","model":"eleven_v4"},{"id":"s17-jack-quietly-he-always-paid-too-much","character":"JACK","text":"He always paid too much, too.","src":"/audio/neonoire/s17/189-jack-quietly-he-always-paid-too-much.mp3","offset":43.8,"duration":2.43,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":47},"neonoire-shot-275":{"audio":[{"id":"s53-vera-don-t-go-anywhere-else-without","character":"VERA","text":"Don't go anywhere else without telling me.","src":"/audio/neonoire/s53/275-vera-don-t-go-anywhere-else-without.mp3","offset":1.3,"duration":2.51,"voice":"4Rn2L1CRjYh93G56jNXI","model":"eleven_v4"},{"id":"s53-jack-i-won-t","character":"JACK","text":"I won't.","src":"/audio/neonoire/s53/275-jack-i-won-t.mp3","offset":4.46,"duration":1.23,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":10},"neonoire-shot-229":{"audio":[{"id":"s60-mara-she-was-right-there-she-was","character":"MARA","text":"She was right there. She was right there and I —","src":"/audio/neonoire/s60/229-mara-she-was-right-there-she-was.mp3","offset":0.6,"duration":3.97,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s60-jack-you-did-the-right-thing","character":"JACK","text":"You did the right thing.","src":"/audio/neonoire/s60/229-jack-you-did-the-right-thing.mp3","offset":5.22,"duration":1.88,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s60-mara-did-i-she-said-she-d","character":"MARA","text":"Did I? She said she'd bring me here. When she finds me. She was so happy.","src":"/audio/neonoire/s60/229-mara-did-i-she-said-she-d.mp3","offset":7.75,"duration":6.43,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s60-jack-if-she-found-this-place-other","character":"JACK","text":"If she found this place, other people can.","src":"/audio/neonoire/s60/229-jack-if-she-found-this-place-other.mp3","offset":15.48,"duration":3.24,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s60-mara-i-know","character":"MARA","text":"I know.","src":"/audio/neonoire/s60/229-mara-i-know.mp3","offset":19.37,"duration":0.99,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s60-mara-find-what-it-opens-and-then","character":"MARA","text":"Find what it opens. And then this ends. I don't want to hide any more. I want my sister.","src":"/audio/neonoire/s60/229-mara-find-what-it-opens-and-then.mp3","offset":21.01,"duration":7.55,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s60-jack-tomorrow-night-i-m-moving-you","character":"JACK","text":"Tomorrow night I'm moving you out of here. Somewhere safe, outside Tokyo. A police car and a house. Someone I trust.","src":"/audio/neonoire/s60/229-jack-tomorrow-night-i-m-moving-you.mp3","offset":29.21,"duration":8.83,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"},{"id":"s60-mara-and-then","character":"MARA","text":"And then?","src":"/audio/neonoire/s60/229-mara-and-then.mp3","offset":38.69,"duration":0.91,"voice":"2NE3noNVoL0UyxXHLs7w","model":"eleven_v4"},{"id":"s60-jack-and-then-i-tell-her-everything","character":"JACK","text":"And then I tell her everything.","src":"/audio/neonoire/s60/229-jack-and-then-i-tell-her-everything.mp3","offset":40.25,"duration":2.12,"voice":"MZhx7pKflsc0sAwciDEy","model":"eleven_v4"}],"duration":43}}}
